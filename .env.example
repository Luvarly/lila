# Copy to .env and fill in. Real environment variables and command-line flags win over this file.

# Required: your Fish Audio API key. Sent only to Fish, never printed or logged.
FISH_API_KEY=
# Voice to speak with: any Fish library voice id or your own clone. Empty = Fish's default voice.
FISH_VOICE_ID=

# Fish models and delivery
# FISH_TTS_MODEL=s2.1-pro          # or s2.1-pro-free, s2-pro
# FISH_STT_MODEL=transcribe-1-pro  # or transcribe-1
# FISH_LATENCY=balanced            # or normal
# FISH_SPEED=1.0

# Lila
# LILA_EXPRESSIVE=0                # 1 = let Claude use cues like [laughing]
# LILA_LANGUAGE=                   # speech-to-text hint, e.g. nl (empty = auto-detect)
# LILA_WORKDIR=                    # folder Claude works in (empty = current folder)
# LILA_ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
# LILA_VOICE_APPROVALS=1           # 0 = deny tools that aren't pre-allowed instead of asking
# LILA_BARGE_IN=1                  # 0 = never listen while speaking (half-duplex)
# LILA_SPEECH_RMS=300
# LILA_BARGE_IN_RMS=1500
# LILA_END_SILENCE_MS=700
# LILA_INPUT_DEVICE=               # number or name, see `lila --list-devices`
# LILA_OUTPUT_DEVICE=
# LILA_IGNORE_API_KEY=0            # 1 = hide ANTHROPIC_API_KEY from Claude Code

# Claude
# CLAUDE_MODEL=                    # e.g. opus, sonnet, haiku; empty = Claude Code's default
# CLAUDE_EFFORT=                   # low, medium, high, xhigh or max; empty = Claude Code's default
